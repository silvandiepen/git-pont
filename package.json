{
  "name": "git-pont-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "docs/site",
    "libs/typescript",
    "kits/worker"
  ],
  "scripts": {
    "swift:build": "swift build",
    "swift:test": "swift test",
    "swift:build:lib": "swift build --package-path libs/swift",
    "swift:test:lib": "swift test --package-path libs/swift",
    "docs:build": "node docs/site/build.mjs",
    "validate": "bash scripts/validate-local.sh",
    "validate:live": "bash scripts/validate-live.sh",
    "ts:build": "npm run build --workspace @git-pont/core",
    "ts:test": "npm run test --workspace @git-pont/core",
    "worker:typecheck": "npm run typecheck --workspace @git-pont/worker",
    "worker:dev": "npm run dev --workspace @git-pont/worker",
    "worker:deploy": "npm run deploy --workspace @git-pont/worker"
  }
}
